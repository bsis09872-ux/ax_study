   "source": [
    "from langchain_core.runnables import chain # chain 데코레이터 사용 (하나가 러너블이면 다 적요됨 체인에서 따라서 다 데코레이터로 싸서 정의 못해도 됨.)\n",
    "\n",
    "@chain\n",
    "def func_a(text):\n",
    "    return f\"func_a:{text}\"\n",
    "\n",
    "def func_b(text):\n",
    "    return f\"func_b:{text}\"\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "de25e325",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "'func_b:func_a:안녕!'"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "run_ab = func_a | func_b\n",
    "run_ab.invoke(\"안녕!\")"
   ]
  },
  {
